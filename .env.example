# MongoDB Atlas Connection String
# Thay thế <username>, <password>, <cluster> bằng thông tin của bạn
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/giapha?retryWrites=true&w=majority

# Ví dụ:
# MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.abc123.mongodb.net/giapha?retryWrites=true&w=majority

# JWT Secret - MUST change in production
JWT_SECRET=your-secure-jwt-secret-here

# CORS Origin (optional, defaults to * in development)
# CORS_ORIGIN=http://localhost:4200
